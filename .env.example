# Where contact-form leads are delivered
FORM_TO_EMAIL=shallsconstructionllc@aol.com
# Sender address. Default is Resend's sandbox sender; switch to an address on the
# verified shallsconstruction.com domain once Resend domain verification is complete.
FORM_FROM_EMAIL="Shall's Website <onboarding@resend.dev>"
# Resend API key. Required in production (form returns 500 "Form not configured" without it).
RESEND_API_KEY=
# Build-time (baked into the client bundle by Vite; set before `npm run build`)
VITE_GA4_MEASUREMENT_ID=
# Build-time
VITE_GSC_VERIFICATION=
# Port the server listens on (Railway sets this automatically)
PORT=5000
