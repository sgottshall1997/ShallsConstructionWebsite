# --- Runtime (server) ---
PORT=5000
NODE_ENV=production
# Resend (https://resend.com). Without a key, form emails are logged, not sent.
RESEND_API_KEY=
# Where contact-form leads go (defaults to COMPANY.email in shared/company.ts)
FORM_TO_EMAIL=
# Verified sender. Use onboarding@resend.dev until shallsconstruction.com is verified in Resend,
# then switch to e.g. "Shall's Construction <website@shallsconstruction.com>"
FORM_FROM_EMAIL=

# --- Build-time (Vite inlines VITE_* at build; changing them requires a rebuild) ---
VITE_GA4_MEASUREMENT_ID=
VITE_GSC_VERIFICATION=
